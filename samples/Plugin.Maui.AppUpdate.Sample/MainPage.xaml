<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.AppUpdate.Sample.MainPage"
             Title="App update">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Label Text="Plugin.Maui.AppUpdate" FontSize="22" FontAttributes="Bold" />
            <Label Text="CheckAsync → StartAsync  ·  Android Play / iOS App Store"
                   TextColor="Gray" />

            <Label x:Name="StatusLabel" FontSize="13" LineBreakMode="WordWrap" />

            <Label Text="Scenario" FontAttributes="Bold" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Recommended" Clicked="OnRecommendedClicked" />
                <Button Text="Mandatory" Clicked="OnMandatoryClicked" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Min version" Clicked="OnMinimumClicked" />
                <Button Text="Maintenance" Clicked="OnMaintenanceClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                <Button Text="Check" Clicked="OnCheckClicked" />
                <Button Text="Start" Clicked="OnStartClicked" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Postpone" Clicked="OnPostponeClicked" />
                <Button Text="Clear postpone" Clicked="OnClearPostponeClicked" />
            </HorizontalStackLayout>

            <Label Text="Result" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label x:Name="ResultLabel" FontFamily="Courier New" FontSize="13" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
