<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS1591;IL2026;IL3050</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <RootNamespace>Plugin.Maui.AppUpdate</RootNamespace>
    <AssemblyName>Plugin.Maui.AppUpdate</AssemblyName>
    <PackageId>Plugin.Maui.AppUpdate</PackageId>
    <Title>Plugin.Maui.AppUpdate</Title>
    <Description>Cross-platform in-app updates for .NET MAUI on iOS and Android. Google Play In-App Updates, App Store version checks, mandatory and recommended prompts, maintenance mode, minimum supported version, release notes, and update postponement.</Description>
    <PackageTags>maui;ios;android;in-app-update;app-update;play-core;app-store;mandatory-update;maintenance;force-update;plugin</PackageTags>
    <Authors>Niladri</Authors>
    <Company>NugetWorld</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NiladriPadhy/Plugin.Maui.AppUpdate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NiladriPadhy/Plugin.Maui.AppUpdate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.0</Version>
    <PackageReleaseNotes>Initial release. MAUI in-app updates for Android (Google Play) and iOS (App Store): CheckAsync / StartAsync, mandatory and recommended updates, maintenance mode, minimum supported version, release notes, and postponement.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.19" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Maui.AppUpdate.Tests" />
  </ItemGroup>

</Project>
